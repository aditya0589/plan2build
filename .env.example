# Environment Configuration for Plan2Build AI

# API Backend Configuration
ENVIRONMENT=development
DEBUG=True
API_V1_STR=/api/v1
PROJECT_NAME="Plan2Build AI"

# Database Settings
# For local development without Docker, SQLite async is used by default:
DATABASE_URL=sqlite+aiosqlite:///./data/plan2build.db
# For PostgreSQL (Docker):
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/plan2build

# File Storage Configuration
STORAGE_BACKEND=local
STORAGE_DIR=./data

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000

# OCR & AI Configuration (Optional API keys if using LLM/VLM assistants)
OCR_ENGINE=tesseract
OPENAI_API_KEY=
GEMINI_API_KEY=
